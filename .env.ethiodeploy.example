APP_NAME="Toko Sumber Urip"
APP_ENV=production
APP_KEY=base64:Z7dRNxHxTCwToDrXVo8LIXIiTZpdRTCiNpwltWzHA/Y=
APP_DEBUG=false
APP_URL=https://sumber-urip-lrv.ethiodeploy.app
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database: tambahkan addon MySQL di EthioDeploy (512MB gratis).
# EthioDeploy menginjeksi DATABASE_URL ke container. config/database.php
# sudah membaca DB_URL lalu fallback ke DATABASE_URL, jadi cukup set
# DB_CONNECTION=mysql di sini (atau di Settings -> Environment Variables).
DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12
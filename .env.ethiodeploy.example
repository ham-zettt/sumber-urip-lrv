APP_NAME="Toko Sumber Urip"
APP_ENV=production
APP_KEY=base64:Z7dRNxHxTCwToDrXVo8LIXIiTZpdRTCiNpwltWzHA/Y=
APP_DEBUG=false
APP_URL=https://sumber-urip.ethiodeploy.app
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database: Tambahkan Addon MySQL di EthioDeploy (Gratis 512MB)
# EthioDeploy akan otomatis menginjeksi variabel DATABASE_URL.
DB_CONNECTION=mysql
DB_URL=${DATABASE_URL}

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12
